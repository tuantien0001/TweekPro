<?xml version="1.0" encoding="utf-8"?>
<!-- Applied on Windows builds only (see TweekPro.csproj AppConfig): enables WinForms PerMonitorV2 handling (WM_DPICHANGED rescaling) in .NET Framework 4.7+. -->
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <System.Windows.Forms.ApplicationConfigurationSection>
    <add key="DpiAwareness" value="PerMonitorV2" />
  </System.Windows.Forms.ApplicationConfigurationSection>
</configuration>
